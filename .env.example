# Copy this file to ".env" (next to docker-compose.yml) and edit it. Docker Compose reads it automatically.
# Keep ".env" private: if you set ADMIN_TOKEN here, it's a secret.

# --- Required: two folders on this machine ---------------------------------------------------------------
# Use absolute paths, outside this project folder, and create them first (mkdir -p ...).
# The database must be on a local disk, not a network share (SQLite and network file systems don't mix).
DATA_PATH=/srv/radio-poller/data
# Put this on a different disk from the database if you can, or on a NAS mount: a backup next to the
# database doesn't survive losing that disk.
BACKUP_PATH=/srv/radio-poller/backups

# --- Run as the user that owns those folders (the output of `id -u` and `id -g`) --------------------------
APP_UID=1000
APP_GID=1000

# --- Optional -----------------------------------------------------------------------------------------------
# PORT=5555
# BIND_ADDRESS=127.0.0.1
# ADMIN_TOKEN=
