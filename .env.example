# Copy this file to ".env" (next to docker-compose.yml) and edit it. Docker Compose reads it automatically.
# Keep ".env" private: if you set ADMIN_TOKEN here, it's a secret.

# --- Run as the user that owns the data and backups folders (the output of `id -u` and `id -g`) -----------
# Create the folders yourself first (mkdir -p data backups); if Docker creates them, root owns them.
APP_UID=1000
APP_GID=1000

# --- Where the data and backups go: ./data and ./backups next to docker-compose.yml unless you change these --
# Use another location (an absolute path, such as a second disk or a NAS mount for the backups) if you like.
# The database must be on a local disk, not a network share (SQLite and network file systems don't mix).
# DATA_PATH=/srv/radio-poller/data
# BACKUP_PATH=/mnt/nas/radio-poller-backups

# --- Optional -----------------------------------------------------------------------------------------------
# PORT=5555
# BIND_ADDRESS=127.0.0.1
# ADMIN_TOKEN=

# --- Optional: exact Spotify links -------------------------------------------------------------------------
# From a Spotify developer app (developer.spotify.com/dashboard, needs a Premium account); see the README's
# Spotify section. Without both, the Spotify buttons open a Spotify search instead. Keep ".env" private.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
